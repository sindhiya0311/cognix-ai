# Server Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/gamelearn
# REQUIRED — the server refuses to start without a strong JWT secret.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Optional: comma-separated allowed browser origins.
# Unset = any origin during development; in production unset = same-origin only.
CORS_ORIGIN=

# OpenRouter Unified AI Gateway
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_PRIMARY=google/gemini-2.0-flash-001
AI_MODEL_FAST=google/gemini-2.0-flash-001
AI_MODEL_FALLBACK=openai/gpt-4o-mini

# Optional Legacy Direct Key (Fallback)
GEMINI_API_KEY=

# Client Configuration
VITE_API_URL=http://localhost:5000/api
